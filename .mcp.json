{
  "mcpServers": {
    "cross-review": {
      "command": "dist\\cross-review.exe",
      "args": [
        "--reviewer", "codex",
        "--level", "fast:gpt-6-luna:high",
        "--level", "standard:gpt-6-luna:xhigh",
        "--level", "thorough:gpt-6-luna:max",
        "--default-level", "standard",
        "--codex-profile", "work"
      ],
      "timeout": 2400000
    }
  }
}
